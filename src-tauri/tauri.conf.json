{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "System Integrity Reminder",
  "version": "0.1.0",
  "identifier": "com.rustic-it.system-integrity-reminder",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "System Integrity Reminder",
        "width": 500,
        "height": 350,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true,
        "decorations": true,
        "visible": false,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
